{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/blog/formation-trading-cpf-qualiopi",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/formation-trading-cpf-qualiopi/",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/candidater",
      "destination": "/candidater/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/t/:chemin/",
      "destination": "https://api.basstrading.fr/t/:chemin"
    },
    {
      "source": "/t/:chemin",
      "destination": "https://api.basstrading.fr/t/:chemin"
    },
    {
      "source": "/p/:path*/",
      "destination": "https://studio.hubtrading.fr/p/:path*"
    },
    {
      "source": "/p/:path*",
      "destination": "https://studio.hubtrading.fr/p/:path*"
    },
    {
      "source": "/l/:code/",
      "destination": "https://studio.hubtrading.fr/l/:code"
    },
    {
      "source": "/l/:code",
      "destination": "https://studio.hubtrading.fr/l/:code"
    }
  ]
}
